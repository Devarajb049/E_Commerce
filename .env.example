# ==============================================================================
# ClickCart Environment Configuration Template
# Copy this file to .env or configure these variables in your deployment dashboard
# (e.g. Render, Railway, Vercel, Netlify, Voroa, or VPS)
# ==============================================================================

# Server Network & Runtime
HOST=0.0.0.0
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection String
# Get this from your Supabase Dashboard -> Project Settings -> Database -> Connection URI
# Formats:
# 1. Transaction Pooler (Recommended for cloud deployments):
#    postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# 2. Session Pooler:
#    postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# 3. Direct Connection:
#    postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# (Note: If omitted or paused, ClickCart automatically runs on its resilient embedded catalog)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Application Security & Authentication
# Generate a random 32+ character string for production
JWT_SECRET=your_secure_random_jwt_secret_min_32_chars_2026
JWT_EXPIRES_IN=1d

# E-Commerce Financial Settings
TAX_RATE=0.18

# CORS Configuration
# Set to your hosted frontend URL (e.g. https://clickcart.vercel.app) or comma-separated list
# Use '*' to permit all origins
CORS_ORIGIN=*

# Client (Frontend) Settings
# When deploying the frontend on a separate domain/CDN (Vercel/Netlify), set this to your backend API URL
# Example: https://clickcart-api.onrender.com/api
# When deployed together on the same domain, leave as /api
VITE_API_URL=/api

# ClickCart Server Environment Configuration
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Connection String
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_supabase_db_password_here@db.zvnihfslrdnvyujxyiov.supabase.co:5432/postgres

# Application Security & Settings
JWT_SECRET=your_secure_jwt_secret_min_32_characters
JWT_EXPIRES_IN=1d
TAX_RATE=0.18
CORS_ORIGIN=http://localhost:3000

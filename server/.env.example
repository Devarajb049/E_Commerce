# ==============================================================================
# ClickCart Server Environment Configuration Template
# Configure these variables in server/.env or your hosting platform dashboard
# ==============================================================================

# Server Network & Runtime
HOST=0.0.0.0
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection String
# Get this from your Supabase Dashboard -> Project Settings -> Database -> Connection URI
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Application Security & Authentication
JWT_SECRET=your_secure_random_jwt_secret_min_32_chars_2026
JWT_EXPIRES_IN=1d

# E-Commerce Financial Settings
TAX_RATE=0.18

# CORS Configuration
# Set to your hosted frontend URL or '*'
CORS_ORIGIN=*
